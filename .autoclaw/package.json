{
  "name": "autoclaw",
  "version": "2.0.0",
  "description": "AutoClaw intelligence + memory layer",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "find . -name '*.js' -not -path './node_modules/*' -not -path './.git/*' -print0 | xargs -0 -n1 node --check",
    "test": "node --input-type=module -e \"import('./tests/integration.test.js').then(async ({ runTests }) => { const result = await runTests(); if (result.failed) process.exitCode = 1; })\"",
    "typecheck": "find . -name '*.js' -not -path './node_modules/*' -not -path './.git/*' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.3.2"
  }
}
