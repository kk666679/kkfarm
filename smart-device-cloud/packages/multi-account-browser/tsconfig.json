{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "paths": {
      "@smart-device-cloud/shared": ["../../shared/src/index.ts"],
      "@sdc/*": ["../*/src/index.ts"]
    }
  },
  "include": ["src"]
}
