# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# YAML files
[*.{yaml,yml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# TypeScript/JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 100

# CSS/SCSS
[*.{css,scss,sass}]
indent_size = 2

# HTML
[*.{html,htm}]
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Environment files
[*.env.*]
indent_size = 0
